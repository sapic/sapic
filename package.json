{
  "name": "sapic",
  "version": "1.0.0",
  "author": "Tim <truecarry@gmail.com>",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "serve": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p .",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "main": "index.js",
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@solidjs/router": "^1.0.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "solid-js": "^1.9.17",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": "git@github.com:sapic/sapic.git",
  "targets": {
    "browser": {
      "engines": {
        "browsers": [
          "> 1%",
          "not dead"
        ]
      }
    }
  },
  "packageManager": "pnpm@12.14.0"
}
