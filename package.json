    "@vue/devtools-api": "^8.2.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "pinia": "^4.1.0",
    "stylus": "^0.64.0",
    "stylus-loader": "^9.0.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-i18n-lite": "^1.0.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.13"
